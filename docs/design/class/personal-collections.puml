@startuml
title C3  Shopping, favorites and viewed history
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #172A3A
skinparam defaultFontSize 15
skinparam ArrowColor #345A72
skinparam Shadowing false
skinparam dpi 150
skinparam TitleFontColor #123A52
skinparam TitleFontSize 19
skinparam ClassBackgroundColor #EDF5FA
skinparam ClassBorderColor #456F89
skinparam ComponentBackgroundColor #EDF5FA
skinparam ComponentBorderColor #456F89
skinparam PackageBorderColor #456F89
skinparam ParticipantBackgroundColor #E6F4F0
skinparam ParticipantBorderColor #417364
skinparam SequenceGroupBackgroundColor #EDF5FA
skinparam SequenceGroupBorderColor #617C8D
!pragma layout smetana
left to right direction
hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 30
class ShoppingService {
  +addMissing(owner: AccountId, recipeId: RecipeId): ShoppingEntry[]
  +list(owner: AccountId): ShoppingEntry[]
  +add(owner: AccountId, name: string): ShoppingAddResult
  +remove(owner: AccountId, entryId: EntryId): boolean
}
class FavoriteService {
  +save(owner: AccountId, recipeId: RecipeId): Recipe
  +list(owner: AccountId): Recipe[]
  +remove(owner: AccountId, recipeId: RecipeId): boolean
}
class RecipeViewService {
  +open(owner: AccountId, recipeId: RecipeId): Recipe
  +history(owner: AccountId): ViewedRecipe[]
}
interface ShoppingRepository {
  +upsertNames(owner: AccountId, names: string[]): void
  +upsertOne(owner: AccountId, name: string): ShoppingAddResult
  +listByOwner(owner: AccountId): ShoppingEntry[]
  +deleteOwned(owner: AccountId, entryId: EntryId): boolean
}
interface FavoriteRepository {
  +upsert(owner: AccountId, recipeId: RecipeId): void
  +listByOwner(owner: AccountId): Recipe[]
  +deleteOwned(owner: AccountId, recipeId: RecipeId): boolean
}
interface HistoryRepository {
  +recordLatest(owner: AccountId, recipeId: RecipeId, at: Instant): void
  +listRecent(owner: AccountId): ViewedRecipe[]
}
class ShoppingEntry {
  +id: EntryId
  +owner: AccountId
  +name: string
  +nameKey: string
}
class ShoppingAddResult <<DTO>> {
  +entry: ShoppingEntry
  +created: boolean
}
class Favorite {
  +owner: AccountId
  +recipeId: RecipeId
}
class RecipeView {
  +owner: AccountId
  +recipeId: RecipeId
  +lastViewedAt: Instant
}
class ViewedRecipe <<DTO>> {
  +recipe: Recipe
  +lastViewedAt: Instant
}
class Recipe <<from C2>>
interface RecipeRepository <<from C2>>
interface InventoryRepository <<from C1>>
interface UnitOfWork <<from C2>>
class SqlShoppingRepository <<SQL adapter>>
class SqlFavoriteRepository <<SQL adapter>>
class SqlHistoryRepository <<SQL adapter>>
SqlShoppingRepository ..|> ShoppingRepository
SqlFavoriteRepository ..|> FavoriteRepository
SqlHistoryRepository ..|> HistoryRepository
ShoppingService ..> ShoppingRepository
ShoppingService ..> RecipeRepository
ShoppingService ..> InventoryRepository : read only
ShoppingService ..> UnitOfWork
FavoriteService ..> FavoriteRepository
FavoriteService ..> RecipeRepository
FavoriteService ..> UnitOfWork
RecipeViewService ..> HistoryRepository
RecipeViewService ..> RecipeRepository
RecipeViewService ..> UnitOfWork
ShoppingRepository ..> ShoppingEntry
ShoppingRepository ..> ShoppingAddResult
FavoriteRepository ..> Favorite
HistoryRepository ..> RecipeView
HistoryRepository ..> ViewedRecipe
Recipe "1" -- "0..1" Favorite : same owner
Recipe "1" -- "0..1" RecipeView : same owner

legend bottom
  AccountId, EntryId and Instant: defined in C1. RecipeId: defined in C2.
  ShoppingAddResult carries the persisted item and selects HTTP 201 or 200.
  ViewedRecipe pairs the complete owned recipe with the latest view time.
endlegend
@enduml
