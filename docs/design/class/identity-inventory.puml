@startuml
title C1  Identity, preferences and inventory
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #172A3A
skinparam defaultFontSize 15
skinparam ArrowColor #345A72
skinparam Shadowing false
skinparam dpi 150
skinparam TitleFontColor #123A52
skinparam TitleFontSize 19
skinparam ClassBackgroundColor #EDF5FA
skinparam ClassBorderColor #456F89
skinparam ComponentBackgroundColor #EDF5FA
skinparam ComponentBorderColor #456F89
skinparam PackageBorderColor #456F89
skinparam ParticipantBackgroundColor #E6F4F0
skinparam ParticipantBorderColor #417364
skinparam SequenceGroupBackgroundColor #EDF5FA
skinparam SequenceGroupBorderColor #617C8D
!pragma layout smetana
left to right direction
hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 30
class Account {
  +id: AccountId
  +email: string
  +emailKey: string
  -passwordHash: string
}
class PreferenceProfile {
  +dietary: string[]
  +allergens: string[]
}
class InventoryEntry {
  +id: EntryId
  +owner: AccountId
  +name: string
  +nameKey: string
  +addedAt: Instant
}
class AccountDTO <<DTO>> {
  +id: AccountId
  +email: string
}
class IdentityService {
  +register(email: string, password: string): AccountDTO
  +signIn(email: string, password: string): JWT
}
class JwtGuard {
  +requireOwner(token: JWT?): AccountId
}
class PreferenceService {
  +read(owner: AccountId): PreferenceProfile
  +replace(owner: AccountId, dietary: string[], allergens: string[]): PreferenceProfile
}
class InventoryService {
  +add(owner: AccountId, name: string): InventoryEntry
  +list(owner: AccountId): InventoryEntry[]
  +remove(owner: AccountId, entryId: EntryId): boolean
}
interface AccountRepository {
  +insertUnique(account: Account): Account
  +findByEmailKey(key: string): Account?
}
interface ProfileRepository {
  +read(owner: AccountId): PreferenceProfile
  +replaceBoth(owner: AccountId, profile: PreferenceProfile): PreferenceProfile
}
interface InventoryRepository {
  +insert(entry: InventoryEntry): InventoryEntry
  +listByOwner(owner: AccountId): InventoryEntry[]
  +deleteOwned(owner: AccountId, entryId: EntryId): boolean
}
interface PasswordHasher {
  +hash(password: string): string
  +verify(password: string, hash: string): boolean
}
interface TokenService {
  +issue(owner: AccountId): JWT
  +verify(token: JWT?): AccountId
}
interface UnitOfWork <<from C2>>
class SqlAccountRepository <<SQL adapter>>
class SqlProfileRepository <<SQL adapter>>
class SqlInventoryRepository <<SQL adapter>>
SqlAccountRepository ..|> AccountRepository
SqlProfileRepository ..|> ProfileRepository
SqlInventoryRepository ..|> InventoryRepository
Account "1" *-- "1" PreferenceProfile : logical profile
Account "1" *-- "0..*" InventoryEntry : owns
IdentityService ..> AccountRepository
IdentityService ..> PasswordHasher
IdentityService ..> TokenService
IdentityService ..> AccountDTO
JwtGuard ..> TokenService
PreferenceService ..> ProfileRepository
PreferenceService ..> UnitOfWork
InventoryService ..> InventoryRepository
AccountRepository ..> Account
ProfileRepository ..> PreferenceProfile
InventoryRepository ..> InventoryEntry

legend bottom
  AccountId, EntryId: opaque string identifiers
  Instant: UTC timestamp serialized as ISO 8601
  JWT: signed token string. T? is optional. T[] is an ordered list.
endlegend
@enduml
